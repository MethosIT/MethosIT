---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  lang?: "it" | "en";
  ogImage?: string;
  alternateIt?: string;
  alternateEn?: string;
}

const {
  title,
  description,
  noindex = false,
  lang = "it",
  ogImage = "/images/hero.webp",
  alternateIt,
  alternateEn,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const absoluteOgImage = new URL(ogImage, Astro.site);
const umamiWebsiteId = import.meta.env.PUBLIC_UMAMI_WEBSITE_ID;
const umamiScriptUrl = import.meta.env.PUBLIC_UMAMI_SCRIPT_URL ?? "https://cloud.umami.is/script.js";
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical} />
    {alternateIt && <link rel="alternate" hreflang="it" href={new URL(alternateIt, Astro.site)} />}
    {alternateEn && <link rel="alternate" hreflang="en" href={new URL(alternateEn, Astro.site)} />}
    {alternateIt && <link rel="alternate" hreflang="x-default" href={new URL(alternateIt, Astro.site)} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Thouraz Pub" />
    <meta property="og:locale" content={lang === "it" ? "it_IT" : "en_GB"} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={absoluteOgImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <link
      rel="preload"
      href="/fonts/montserrat-latin-variable.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <title>{title}</title>
    {umamiWebsiteId && (
      <script
        defer
        src={umamiScriptUrl}
        data-website-id={umamiWebsiteId}
      ></script>
    )}
  </head>
  <body>
    <a class="skip-link" href="#main-content">{lang === "it" ? "Vai al contenuto" : "Skip to content"}</a>
    <slot />
    <script is:inline>
      document.addEventListener("click", (event) => {
        const origin = event.target;
        if (!(origin instanceof Element)) return;

        const target = origin.closest("[data-track]");
        if (!target) return;

        const eventName = target.getAttribute("data-track");
        if (!eventName) return;

        const props = {
          location: target.getAttribute("data-track-location") || "unknown",
          href: target.getAttribute("href") || "",
          language: document.documentElement.lang || "",
        };

        if (window.umami && typeof window.umami.track === "function") {
          window.umami.track(eventName, props);
        }

        if (window.plausible && typeof window.plausible === "function") {
          window.plausible(eventName, { props });
        }
      });
    </script>
  </body>
</html>
