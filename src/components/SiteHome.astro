---
import { site } from "../data/site";

interface Props {
  lang: "it" | "en";
}

const { lang } = Astro.props;
const isIt = lang === "it";

const copy = isIt
  ? {
      navExperience: "Esperienza",
      navGelato: "Gelato",
      navReviews: "Recensioni",
      navVisit: "Dove siamo",
      navEvents: "Sala eventi",
      menu: "Menu",
      heroEyebrow: "DAL 1987 · MONTECCHIO PRECALCINO",
      heroTitle: "Ogni cocktail comincia da una conversazione.",
      heroText:
        "Raccontaci cosa ti piace, cosa vuoi scoprire e come vuoi sentirti. Al Thouraz il cocktail nasce insieme a te, con cura, ascolto e ingredienti scelti.",
      heroMenu: "Scopri i listini",
      heroWhatsapp: "Prenota su WhatsApp",
      statSince: "Dal",
      statHours: "Orario",
      statPlace: "Montecchio Precalcino",
      experienceEyebrow: "THE THOURAZ WAY",
      experienceTitle: "Non scegliere solo un drink. Costruiscilo con noi.",
      experienceText:
        "Partiamo dai tuoi gusti — dolce, secco, fresco, intenso, speziato, analcolico — e troviamo insieme profumi, ingredienti e carattere del cocktail perfetto per te.",
      experienceQuote:
        "La cura non arriva dopo il prodotto: è il modo in cui il prodotto nasce.",
      gelatoEyebrow: "GELATERIA ARTIGIANALE",
      gelatoTitle: "Materie prime di qualità, gusto senza compromessi.",
      gelatoText:
        "I nostri gelati artigianali sono preparati con materie prime di alta qualità e sono tutti senza glutine e senza lattosio. Una proposta pensata con la stessa attenzione che mettiamo nei cocktail.",
      gelatoNote: "Per allergie o esigenze specifiche, parlane sempre con il personale.",
      spacesEyebrow: "IL LOCALE",
      spacesTitle: "Una serata che può cambiare ritmo, senza cambiare posto.",
      spacesText:
        "Lounge, bancone e terrazza: spazi diversi per una serata tranquilla, un incontro tra amici o un drink fino a tardi.",
      visitEyebrow: "VIENI A TROVARCI",
      visitTitle: "Thouraz Pub",
      hoursLabel: "Orari",
      hoursValue: "20:00–04:00",
      addressLabel: "Indirizzo",
      phoneLabel: "Telefono",
      reserveLabel: "Prenotazioni",
      reserveValue: "Telefono o WhatsApp",
      directions: "Apri in Google Maps",
      call: "Chiama",
      whatsapp: "WhatsApp",
      instagram: "Instagram",
      reviewsEyebrow: "DICONO DI NOI",
      reviewsTitle: "Un posto che resta.",
      reviewsText: "Cocktail su misura, cura del locale e gelato artigianale sono tra gli aspetti che tornano più spesso nelle recensioni.",
      reviewsRating: "su Google",
      reviewsCount: "oltre 480 recensioni",
      readReviews: "Leggi le recensioni su Google",
      leaveReview: "Lascia una recensione",
      reviewLabel: "Recensione Google",
      mobileCtaLabel: "Azioni rapide",
      footer: "Cocktail su misura · Gelato artigianale · Dal 1987",
      languageLabel: "EN",
      languageHref: "/en/",
      languageAria: "English version",
    }
  : {
      navExperience: "Experience",
      navGelato: "Gelato",
      navReviews: "Reviews",
      navVisit: "Visit us",
      navEvents: "Private events",
      menu: "Menu",
      heroEyebrow: "SINCE 1987 · MONTECCHIO PRECALCINO",
      heroTitle: "Every cocktail starts with a conversation.",
      heroText:
        "Tell us what you enjoy, what you want to discover and what kind of mood you are in. At Thouraz, your cocktail is created with you — through care, listening and carefully selected ingredients.",
      heroMenu: "View the menus",
      heroWhatsapp: "Book on WhatsApp",
      statSince: "Since",
      statHours: "Hours",
      statPlace: "Montecchio Precalcino",
      experienceEyebrow: "THE THOURAZ WAY",
      experienceTitle: "Don't just pick a drink. Create it with us.",
      experienceText:
        "We start from your tastes — sweet, dry, fresh, bold, spicy or alcohol-free — and together we find the aromas, ingredients and character of the perfect cocktail for you.",
      experienceQuote:
        "Care is not something added after the product: it is how the product begins.",
      gelatoEyebrow: "ARTISAN GELATO",
      gelatoTitle: "Quality ingredients, flavour without compromise.",
      gelatoText:
        "Our artisan gelato is made with high-quality ingredients, and every flavour is gluten-free and lactose-free. The same attention we put into cocktails goes into every scoop.",
      gelatoNote: "For allergies or specific dietary requirements, always speak with our staff.",
      spacesEyebrow: "THE VENUE",
      spacesTitle: "Change the pace of your evening without changing places.",
      spacesText:
        "Lounge areas, bar seating and terrace: different spaces for a quiet evening, drinks with friends or a late-night stop.",
      visitEyebrow: "COME AND SEE US",
      visitTitle: "Thouraz Pub",
      hoursLabel: "Opening hours",
      hoursValue: "20:00–04:00",
      addressLabel: "Address",
      phoneLabel: "Phone",
      reserveLabel: "Reservations",
      reserveValue: "Phone or WhatsApp",
      directions: "Open in Google Maps",
      call: "Call",
      whatsapp: "WhatsApp",
      instagram: "Instagram",
      reviewsEyebrow: "WHAT GUESTS SAY",
      reviewsTitle: "A place that stays with you.",
      reviewsText: "Made-to-measure cocktails, attention to detail and artisan gelato are among the themes guests mention most often.",
      reviewsRating: "on Google",
      reviewsCount: "480+ reviews",
      readReviews: "Read reviews on Google",
      leaveReview: "Leave a review",
      reviewLabel: "Google review",
      mobileCtaLabel: "Quick actions",
      footer: "Made-to-measure cocktails · Artisan gelato · Since 1987",
      languageLabel: "IT",
      languageHref: "/home/",
      languageAria: "Versione italiana",
    };

const reviewQuotes = isIt
  ? [
      { author: "Roberta N.", text: "Un luogo dove si respira una grande cura e piacevolezza." },
      { author: "Pietro P.", text: "Il prodotto è di altissima qualità." },
      { author: "Carlotta S.", text: "Questo è diventato il nostro posto speciale." },
    ]
  : [
      { author: "Roberta Nebuloni", text: "A place where you can feel genuine care and warmth." },
      { author: "Pietro Pastori", text: "The product is of the highest quality." },
      { author: "Carlotta S.", text: "This has become our special place." },
    ];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BarOrPub",
  name: site.name,
  "@id": "https://thourazpub.it/#thouraz-pub",
  url: "https://thourazpub.it/home/",
  foundingDate: String(site.founded),
  telephone: site.phoneDisplay,
  email: site.email,
  image: "https://thourazpub.it/images/hero.webp",
  openingHoursSpecification: [
    {
      "@type": "OpeningHoursSpecification",
      dayOfWeek: [
        "Monday",
        "Tuesday",
        "Wednesday",
        "Thursday",
        "Friday",
        "Saturday",
        "Sunday",
      ],
      opens: "20:00",
      closes: "04:00",
    },
  ],
  address: {
    "@type": "PostalAddress",
    streetAddress: site.address.street,
    postalCode: site.address.postalCode,
    addressLocality: site.address.city,
    addressRegion: site.address.province,
    addressCountry: site.address.country,
  },
  hasMenu: "https://thourazpub.it/menu/",
  sameAs: [site.instagram],
};
---

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

<header class="topbar">
  <a class="brand" href={isIt ? "/home/" : "/en/"} aria-label="Thouraz Pub">
    <img src="/images/logo.webp" alt="Thouraz Pub" width="660" height="274" />
  </a>

  <nav aria-label={isIt ? "Navigazione principale" : "Main navigation"}>
    <a href="#experience">{copy.navExperience}</a>
    <a href="#gelato">{copy.navGelato}</a>
    <a href="#reviews">{copy.navReviews}</a>
    <a href="#visit">{copy.navVisit}</a>
    <a href={isIt ? "/sala-eventi/" : "/en/private-events/"} data-track="private_events_click" data-track-location="header">{copy.navEvents}</a>
    <a class="menu-pill" href="/menu/" data-track="menu_click" data-track-location="header">{copy.menu}</a>
    <a class="language" href={copy.languageHref} lang={isIt ? "en" : "it"} hreflang={isIt ? "en" : "it"} aria-label={copy.languageAria} data-track="language_switch" data-track-location="header">
      {copy.languageLabel}
    </a>
  </nav>

  <details class="mobile-nav">
    <summary aria-label={isIt ? "Apri navigazione" : "Open navigation"}>
      <span aria-hidden="true"></span>
      <span aria-hidden="true"></span>
      <span aria-hidden="true"></span>
    </summary>
    <div class="mobile-nav-panel">
      <a href="#experience">{copy.navExperience}</a>
      <a href="#gelato">{copy.navGelato}</a>
      <a href="#reviews">{copy.navReviews}</a>
      <a href="#visit">{copy.navVisit}</a>
      <a href={isIt ? "/sala-eventi/" : "/en/private-events/"} data-track="private_events_click" data-track-location="mobile_nav">{copy.navEvents}</a>
      <a href="/menu/" data-track="menu_click" data-track-location="mobile_nav">{copy.menu}</a>
      <a href={copy.languageHref} lang={isIt ? "en" : "it"} hreflang={isIt ? "en" : "it"} data-track="language_switch" data-track-location="mobile_nav">
        {isIt ? "English" : "Italiano"}
      </a>
    </div>
  </details>
</header>

<main id="main-content" tabindex="-1">
  <section class="hero" id="hero">
    <img
      class="hero-image"
      src="/images/hero.webp"
      alt={isIt ? "Lounge del Thouraz Pub con cocktail" : "Thouraz Pub lounge with a cocktail"}
      width="2200"
      height="1238"
      loading="eager"
      fetchpriority="high"
    />
    <div class="hero-shade"></div>
    <div class="hero-content">
      <p class="eyebrow">{copy.heroEyebrow}</p>
      <h1>{copy.heroTitle}</h1>
      <p class="hero-copy">{copy.heroText}</p>
      <div class="hero-actions">
        <a class="button button-light" href="/menu/" data-track="menu_click" data-track-location="hero">{copy.heroMenu}</a>
        <a class="button button-glass" href={site.whatsapp} target="_blank" rel="noopener noreferrer" data-track="whatsapp_click" data-track-location="hero">
          {copy.heroWhatsapp}
        </a>
      </div>
    </div>
    <div class="hero-stats" aria-label={isIt ? "Informazioni rapide" : "Quick information"}>
      <span><strong>{copy.statSince}</strong> {site.founded}</span>
      <span><strong>{copy.statHours}</strong> {site.hours}</span>
      <span><strong>{copy.statPlace}</strong></span>
    </div>
  </section>

  <section id="experience" class="split-section section-shell">
    <div class="portrait-frame">
      <img
        src="/images/bar.webp"
        alt={isIt ? "Selezione di bottiglie al bancone" : "Bottle selection at the bar"}
        width="1238"
        height="2200"
        loading="lazy"
      />
    </div>
    <div class="section-copy">
      <p class="eyebrow">{copy.experienceEyebrow}</p>
      <h2>{copy.experienceTitle}</h2>
      <p class="body-copy">{copy.experienceText}</p>
      <p class="quote">{copy.experienceQuote}</p>

      <div class="experience-mobile-carousel" role="region" tabindex="0" aria-label={isIt ? "Foto cocktail e bancone" : "Cocktail and bar photos"}>
        <figure>
          <img
            src="/images/bar.webp"
            alt={isIt ? "Selezione di bottiglie al bancone" : "Bottle selection at the bar"}
            width="1238"
            height="2200"
            loading="lazy"
          />
        </figure>
        <figure>
          <img
            src="/images/cocktail.webp"
            alt={isIt ? "Cocktail personalizzato del Thouraz Pub" : "A personalised cocktail at Thouraz Pub"}
            width="1469"
            height="2200"
            loading="lazy"
          />
        </figure>
      </div>
    </div>
  </section>

  <section class="photo-break">
    <img
      src="/images/cocktail.webp"
      alt={isIt ? "Cocktail personalizzato del Thouraz Pub" : "A personalised cocktail at Thouraz Pub"}
      width="1469"
      height="2200"
      loading="lazy"
    />
  </section>

  <section id="gelato" class="gelato-section section-shell">
    <div class="section-copy">
      <p class="eyebrow">{copy.gelatoEyebrow}</p>
      <h2>{copy.gelatoTitle}</h2>
      <p class="body-copy">{copy.gelatoText}</p>
      <p class="fine-print">{copy.gelatoNote}</p>
    </div>
    <div class="gelato-grid" role="region" tabindex="0" aria-label={isIt ? "Foto gelateria" : "Gelato photos"}>
      <figure class="gelato-main">
        <img
          src="/images/gelato.webp"
          alt={isIt ? "Gelato artigianale del Thouraz Pub" : "Artisan gelato at Thouraz Pub"}
          width="1238"
          height="2200"
          loading="lazy"
        />
      </figure>
      <figure>
        <img
          src="/images/gelato-display.webp"
          alt={isIt ? "Selezione di gelati artigianali" : "Selection of artisan gelato"}
          width="2200"
          height="1469"
          loading="lazy"
        />
      </figure>
    </div>
  </section>

  <section class="spaces section-shell">
    <div class="spaces-heading">
      <p class="eyebrow">{copy.spacesEyebrow}</p>
      <h2>{copy.spacesTitle}</h2>
      <p class="body-copy">{copy.spacesText}</p>
    </div>

    <div class="gallery" role="region" tabindex="0" aria-label={isIt ? "Foto del locale" : "Venue photos"}>
      <figure class="gallery-wide">
        <img src="/images/interior.webp" alt={isIt ? "Interno del locale" : "Interior of the venue"} width="2200" height="1238" loading="lazy" />
      </figure>
      <figure>
        <img src="/images/lounge.webp" alt={isIt ? "Lounge del Thouraz Pub" : "Thouraz Pub lounge"} width="1237" height="2200" loading="lazy" />
      </figure>
      <figure>
        <img src="/images/cocktail2.webp" alt={isIt ? "Cocktail servito al Thouraz Pub" : "Cocktail served at Thouraz Pub"} width="1469" height="2200" loading="lazy" />
      </figure>
      <figure class="gallery-wide">
        <img src="/images/terrace.webp" alt={isIt ? "Terrazza del Thouraz Pub" : "Thouraz Pub terrace"} width="2200" height="1571" loading="lazy" />
      </figure>
    </div>
  </section>

  <section id="reviews" class="reviews section-shell">
    <div class="reviews-heading">
      <div>
        <p class="eyebrow">{copy.reviewsEyebrow}</p>
        <h2>{copy.reviewsTitle}</h2>
        <p class="body-copy">{copy.reviewsText}</p>
      </div>
      <div class="google-rating" aria-label={`${site.googleRating} / 5 ${copy.reviewsRating}, ${copy.reviewsCount}`}>
        <span class="rating-stars" aria-hidden="true">★★★★★</span>
        <strong>{site.googleRating.toLocaleString(isIt ? "it-IT" : "en-GB")} / 5</strong>
        <span>{copy.reviewsRating} · {copy.reviewsCount}</span>
      </div>
    </div>

    <div class="reviews-grid" role="list">
      {reviewQuotes.map((review) => (
        <article class="review-card" role="listitem">
          <div class="review-stars" aria-hidden="true">★★★★★</div>
          <blockquote>“{review.text}”</blockquote>
          <p><strong>{review.author}</strong><span>{copy.reviewLabel}</span></p>
        </article>
      ))}
    </div>

    <div class="reviews-actions">
      <a class="button button-light" href={site.googleReviews} target="_blank" rel="noopener noreferrer" data-track="google_reviews_click" data-track-location="reviews">
        {copy.readReviews}
      </a>
      <a class="button button-outline" href={site.googleReviewWrite} target="_blank" rel="noopener noreferrer" data-track="google_review_write_click" data-track-location="reviews">
        {copy.leaveReview}
      </a>
    </div>
  </section>

  <section id="visit" class="visit">
    <div class="visit-inner">
      <div class="visit-heading">
        <p class="eyebrow">{copy.visitEyebrow}</p>
        <h2>{copy.visitTitle}</h2>
      </div>

      <div class="info-grid">
        <div class="info-block">
          <span>{copy.hoursLabel}</span>
          <strong>{copy.hoursValue}</strong>
        </div>
        <div class="info-block">
          <span>{copy.addressLabel}</span>
          <strong>{site.address.street}<br />{site.address.postalCode} {site.address.city} ({site.address.province})</strong>
        </div>
        <div class="info-block">
          <span>{copy.phoneLabel}</span>
          <strong>{site.phoneDisplay}</strong>
        </div>
        <div class="info-block">
          <span>{copy.reserveLabel}</span>
          <strong>{copy.reserveValue}</strong>
        </div>
      </div>

      <div class="contact-actions">
        <a class="button button-light" href={site.maps} target="_blank" rel="noopener noreferrer" data-track="maps_click" data-track-location="visit">{copy.directions}</a>
        <a class="button button-outline" href={site.phoneHref} data-track="call_click" data-track-location="visit">{copy.call}</a>
        <a class="button button-outline" href={site.whatsapp} target="_blank" rel="noopener noreferrer" data-track="whatsapp_click" data-track-location="visit">{copy.whatsapp}</a>
        <a class="button button-outline" href={site.instagram} target="_blank" rel="noopener noreferrer" data-track="instagram_click" data-track-location="visit">{copy.instagram}</a>
      </div>
    </div>
  </section>
</main>

<div class="mobile-cta" aria-label={copy.mobileCtaLabel}>
  <a href={site.phoneHref} data-track="call_click" data-track-location="sticky">{copy.call}</a>
  <a href={site.whatsapp} target="_blank" rel="noopener noreferrer" data-track="whatsapp_click" data-track-location="sticky">{copy.whatsapp}</a>
</div>

<script is:inline>
  const hero = document.getElementById("hero");
  const mobileCta = document.querySelector(".mobile-cta");
  const mobileNav = document.querySelector(".mobile-nav");

  mobileNav?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => mobileNav.removeAttribute("open"));
  });

  if (hero && mobileCta && "IntersectionObserver" in window) {
    const observer = new IntersectionObserver(
      ([entry]) => {
        mobileCta.classList.toggle("is-visible", !entry.isIntersecting);
      },
      { threshold: 0.08 }
    );
    observer.observe(hero);
  }
</script>

<footer>
  <a class="footer-brand" href={isIt ? "/home/" : "/en/"} aria-label="Thouraz Pub">
    <img src="/images/logo.webp" alt="Thouraz Pub" width="660" height="274" loading="lazy" decoding="async" />
  </a>
  <p>{copy.footer}</p>
  <p>© {new Date().getFullYear()} Thouraz Pub</p>
</footer>

<style>
  :global(body) {
    background: #0b0b0a;
    color: #f3efe7;
  }

  :global(::selection) {
    background: #b99763;
    color: #10100f;
  }

  .topbar {
    position: absolute;
    inset: 0 0 auto;
    z-index: 20;
    width: min(100% - 2.2rem, 1280px);
    margin: 0 auto;
    padding: 1.4rem 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.2rem;
  }

  .brand {
    display: flex;
    align-items: center;
    color: #fff;
    text-decoration: none;
  }

  .brand img {
    width: 96px;
    height: 54px;
    object-fit: contain;
    object-position: left center;
  }

  nav {
    display: flex;
    align-items: center;
    gap: 1.2rem;
  }

  nav a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    min-width: 44px;
    color: rgba(255,255,255,.82);
    font-size: .82rem;
    font-weight: 600;
    text-decoration: none;
  }

  nav a:hover {
    color: #fff;
  }

  .menu-pill,
  .language {
    border: 1px solid rgba(255,255,255,.28);
    border-radius: 999px;
    padding: .65rem .9rem;
  }

  .language {
    min-width: 44px;
    text-align: center;
  }

  .mobile-nav {
    display: none;
    position: relative;
  }

  .mobile-nav summary {
    width: 48px;
    height: 48px;
    display: grid;
    place-content: center;
    gap: 5px;
    list-style: none;
    cursor: pointer;
    border: 1px solid rgba(255,255,255,.28);
    border-radius: 999px;
    background: rgba(10,10,9,.18);
    backdrop-filter: blur(12px);
  }

  .mobile-nav summary::-webkit-details-marker {
    display: none;
  }

  .mobile-nav summary span {
    width: 19px;
    height: 1.5px;
    display: block;
    background: #fff;
    transition: transform .2s ease, opacity .2s ease;
  }

  .mobile-nav[open] summary span:nth-child(1) {
    transform: translateY(6.5px) rotate(45deg);
  }

  .mobile-nav[open] summary span:nth-child(2) {
    opacity: 0;
  }

  .mobile-nav[open] summary span:nth-child(3) {
    transform: translateY(-6.5px) rotate(-45deg);
  }

  .mobile-nav-panel {
    position: absolute;
    top: calc(100% + .65rem);
    right: 0;
    width: min(78vw, 300px);
    padding: .55rem;
    display: grid;
    border: 1px solid rgba(255,255,255,.13);
    background: rgba(15,14,12,.96);
    box-shadow: 0 22px 55px rgba(0,0,0,.38);
    backdrop-filter: blur(18px);
  }

  .mobile-nav-panel a {
    min-height: 48px;
    display: flex;
    align-items: center;
    padding: .75rem .9rem;
    color: #f3efe7;
    text-decoration: none;
    font-size: .88rem;
    font-weight: 650;
    border-bottom: 1px solid rgba(255,255,255,.08);
  }

  .mobile-nav-panel a:last-child {
    border-bottom: 0;
    color: #d8bc8b;
  }

  .hero {
    position: relative;
    min-height: min(940px, 100svh);
    display: grid;
    align-items: end;
    overflow: hidden;
    background: #1a1411;
  }

  .hero-image,
  .hero-shade {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .hero-image {
    object-fit: cover;
    object-position: 50% 55%;
  }

  .hero-shade {
    background:
      linear-gradient(180deg, rgba(5,5,5,.20) 0%, rgba(5,5,5,.12) 28%, rgba(5,5,5,.72) 78%, rgba(5,5,5,.96) 100%),
      linear-gradient(90deg, rgba(5,5,5,.48), rgba(5,5,5,.03) 70%);
  }

  .hero-content {
    position: relative;
    z-index: 2;
    width: min(100% - 2.2rem, 1280px);
    margin: 0 auto;
    padding: 10rem 0 8.5rem;
  }

  .eyebrow {
    margin: 0 0 1.1rem;
    color: #d8bc8b;
    font-size: .74rem;
    font-weight: 800;
    letter-spacing: .24em;
  }

  h1 {
    max-width: 980px;
    margin: 0;
    font-size: clamp(3.3rem, 8.7vw, 8rem);
    line-height: .91;
    letter-spacing: -.06em;
    text-wrap: balance;
    overflow-wrap: break-word;
  }

  .hero-copy {
    max-width: 690px;
    margin: 1.8rem 0 0;
    color: rgba(255,255,255,.82);
    font-size: clamp(1.04rem, 1.8vw, 1.3rem);
    line-height: 1.7;
