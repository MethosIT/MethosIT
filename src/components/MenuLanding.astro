---
import { menuLinks } from "../data/site";
---

<main class="menu-shell">
  <img class="logo" src="/LogoThouraz.png" alt="Logo Thouraz Pub" />

  <div class="intro">
    <p class="welcome">🍸 Benvenuti al Thouraz Pub 🍨</p>
    <p>
      Applichiamo prezzi diversi in base all'orario di ingresso nel locale:
      <strong>prima arrivi, meno spendi!</strong>
    </p>
    <p><strong>Scopri il tuo listino selezionando l'orario di entrata.</strong></p>
    <p class="note">
      Il listino viene bloccato al momento dell'ingresso e rimane valido per tutta la serata.
    </p>
  </div>

  <div class="menu-grid">
    {menuLinks.map((menu) => (
      <a class="menu-button" href={menu.href} target="_blank" rel="noopener noreferrer">
        <span>{menu.label}</span>
        <small>{menu.subtitle}</small>
      </a>
    ))}
  </div>

  <a class="site-link" href="/home">Scopri il Thouraz Pub →</a>
</main>

<style>
  .menu-shell {
    width: min(100%, 720px);
    min-height: 100vh;
    margin: 0 auto;
    padding: 2rem 1rem 3rem;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .logo {
    width: clamp(140px, 35vw, 220px);
    max-height: 160px;
    object-fit: contain;
    border-radius: 14px;
    filter: drop-shadow(0 6px 14px rgba(0, 0, 0, 0.25));
  }

  .intro {
    max-width: 620px;
    margin: 1rem auto 1.6rem;
    text-align: center;
    font-size: 1.03rem;
    line-height: 1.65;
  }

  .intro p {
    margin: .45rem 0;
  }

  .welcome {
    font-weight: 700;
    font-size: 1.08rem;
  }

  .note {
    font-style: italic;
    opacity: .9;
  }

  .menu-grid {
    width: min(100%, 360px);
    display: grid;
    gap: .9rem;
  }

  .menu-button {
    display: block;
    padding: 1.05rem 1.4rem;
    color: #fff;
    background: linear-gradient(90deg, #b38e5d, #e3c88b);
    border-radius: 16px;
    box-shadow: 0 6px 16px rgba(0, 0, 0, .25);
    text-align: center;
    text-decoration: none;
    font-size: 1.14rem;
    font-weight: 700;
    transition: transform .18s ease, box-shadow .18s ease, filter .18s ease;
  }

  .menu-button:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 22px rgba(0, 0, 0, .35);
    filter: brightness(1.05);
  }

  .menu-button small {
    display: block;
    margin-top: .18rem;
    font-size: .78rem;
    font-weight: 400;
    font-style: italic;
    opacity: .9;
  }

  .site-link {
    margin-top: 1.8rem;
    font-size: .9rem;
    opacity: .8;
    text-underline-offset: 4px;
  }

  .site-link:hover {
    opacity: 1;
  }
</style>
